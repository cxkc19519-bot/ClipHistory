    <sys:String x:Key="ConfirmTitle">确认清空</sys:String><sys:String x:Key="ConfirmClearRegular">确定清空全部普通记录吗？此操作不可撤销，置顶记录会保留。</sys:String>
    <sys:String x:Key="ConfirmClearAll">确定清空包括置顶内容在内的全部记录吗？此操作不可撤销。</sys:String>
    <sys:String x:Key="ClearedCount">已清空 {0} 条记录</sys:String>
</ResourceDictionary>
