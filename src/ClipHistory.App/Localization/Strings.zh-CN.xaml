    <sys:String x:Key="FollowSystem">跟随 Windows</sys:String>
    <sys:String x:Key="Startup">开机自动启动 ClipHistory</sys:String>
    <sys:String x:Key="SettingsNote">设置保存在本机。置顶记录不受保存期限影响。</sys:String>
