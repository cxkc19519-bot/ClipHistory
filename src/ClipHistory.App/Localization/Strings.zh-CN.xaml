    <sys:String x:Key="Image">图片</sys:String><sys:String x:Key="Files">文件</sys:String>
    <sys:String x:Key="Pinned">置顶</sys:String><sys:String x:Key="Unpin">取消置顶</sys:String>
    <sys:String x:Key="CopyAgain">再次复制</sys:String><sys:String x:Key="Delete">删除</sys:String>
    <sys:String x:Key="Undo">撤销删除</sys:String>
    <sys:String x:Key="Empty">暂无剪贴板记录，复制一些文字、图片或文件试试。</sys:String>
    <sys:String x:Key="Recording">正在记录剪贴板</sys:String>
    <sys:String x:Key="SettingsTitle">ClipHistory 设置</sys:String>
    <sys:String x:Key="RetentionLabel">普通记录保存期限</sys:String>
    <sys:String x:Key="LanguageLabel">界面语言</sys:String>
