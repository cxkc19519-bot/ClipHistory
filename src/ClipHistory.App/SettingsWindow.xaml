<Window x:Class="ClipHistory.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource SettingsTitle}" Width="430" Height="480"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#F5F9FD" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="#24577A" Text="{DynamicResource Settings}" />
        <StackPanel Grid.Row="1" Margin="0,22,0,0">
            <TextBlock Margin="0,0,0,7" Text="{DynamicResource RetentionLabel}" />
            <ComboBox x:Name="RetentionBox" SelectedValuePath="Tag">
                <ComboBoxItem Tag="1" Content="{DynamicResource Day1}" />
                <ComboBoxItem Tag="3" Content="{DynamicResource Day3}" />
                <ComboBoxItem Tag="5" Content="{DynamicResource Day5}" />
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,18,0,0">
            <TextBlock Margin="0,0,0,7" Text="{DynamicResource LanguageLabel}" />
            <ComboBox x:Name="LanguageBox" SelectedValuePath="Tag">
                <ComboBoxItem Tag="System" Content="{DynamicResource FollowSystem}" />
                <ComboBoxItem Tag="Chinese" Content="简体中文" />
                <ComboBoxItem Tag="English" Content="English" />
            </ComboBox>
            <TextBlock Margin="0,16,0,7" Text="{DynamicResource HotKeyLabel}" />
            <ComboBox x:Name="HotKeyBox" SelectedValuePath="Tag">
                <ComboBoxItem Tag="ControlShiftV" Content="Ctrl + Shift + V" />
                <ComboBoxItem Tag="ControlAltV" Content="Ctrl + Alt + V" />
                <ComboBoxItem Tag="ControlShiftC" Content="Ctrl + Shift + C" />
            </ComboBox>
            <CheckBox x:Name="StartupCheckBox" Margin="0,20,0,0" Content="{DynamicResource Startup}" />
        </StackPanel>
        <TextBlock Grid.Row="3" Margin="0,18,0,0" Foreground="#6B7280" TextWrapping="Wrap"
                   Text="{DynamicResource SettingsNote}" />
        <StackPanel Grid.Row="3" Margin="0,70,0,0" Orientation="Horizontal">
            <Button Padding="10,7" Margin="0,0,8,0" Foreground="#B43C3C"
                    Content="{DynamicResource ClearRegular}" Click="ClearRegularButton_Click" />
            <Button Padding="10,7" Foreground="#B43C3C"
                    Content="{DynamicResource ClearAll}" Click="ClearAllButton_Click" />
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="86" Margin="0,0,8,0" Padding="10,7" Content="{DynamicResource Cancel}" Click="CancelButton_Click" />
            <Button Width="86" Padding="10,7" Background="#75B8F7" Content="{DynamicResource Save}" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
